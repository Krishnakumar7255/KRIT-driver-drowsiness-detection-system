import cv2
import mediapipe as mp
import numpy as np
import serial
import time

arduino = serial.Serial(port='COM3', baudrate=9600, timeout=1)
time.sleep(2)

mp_face = mp.solutions.face_mesh
LEFT_EYE_IDX = [33, 160, 158, 133, 153, 144]
RIGHT_EYE_IDX = [263, 387, 385, 362, 380, 373]

def distance(p1, p2):
    return np.linalg.norm(np.array(p1) - np.array(p2))

def eye_aspect_ratio(pts):
    if len(pts) < 6: return 0.0
    p1, p2, p3, p4, p5, p6 = pts
    vert = distance(p2, p6) + distance(p3, p5)
    horiz = 2.0 * distance(p1, p4)
    return vert / horiz if horiz != 0 else 0.0

def get_points(landmarks, idxs, w, h):
    return [(landmarks[i].x * w, landmarks[i].y * h) for i in idxs]

cap = cv2.VideoCapture(0)
EAR_THRESHOLD = 0.21
CONSEC_FRAMES_DROWSY = 30
drowsy_frames = 0

with mp_face.FaceMesh(max_num_faces=1, refine_landmarks=True) as face_mesh:
    while True:
        ret, frame = cap.read()
        if not ret: break
        h, w = frame.shape[:2]
        rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        result = face_mesh.process(rgb)

        if result.multi_face_landmarks:
            face = result.multi_face_landmarks[0]
            left_pts = get_points(face.landmark, LEFT_EYE_IDX, w, h)
            right_pts = get_points(face.landmark, RIGHT_EYE_IDX, w, h)
            ear = (eye_aspect_ratio(left_pts) + eye_aspect_ratio(right_pts)) / 2.0

            if ear < EAR_THRESHOLD:
                drowsy_frames += 1
            else:
                drowsy_frames = 0

            if drowsy_frames >= CONSEC_FRAMES_DROWSY:
                cv2.putText(frame, "DROWSY!", (50, 100),
                            cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0,0,255), 3)
                arduino.write(b'1')   # send signal to Arduino (red LED ON)
            else:
                arduino.write(b'0')   # send signal to Arduino (green LED ON)

        cv2.imshow("Drowsiness Detection", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

cap.release()
cv2.destroyAllWindows()